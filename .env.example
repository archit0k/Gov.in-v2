# Gov.in — AI gateway
#
# Optional. Without a key the deterministic navigation engine handles every
# request and the product works end to end; the model only adds ambiguous-intent
# routing, in-journey answers and RTI drafting.
OPENAI_API_KEY=sk-...

# Any OpenAI-compatible endpoint. Leave unset to talk to OpenAI directly.
# e.g. https://api.aicredits.in/v1
# OPENAI_BASE_URL=

# Model id as your endpoint names it. OpenAI direct: gpt-5.4-mini.
# Gateways that namespace by provider: openai/gpt-5.4-mini.
OPENAI_MODEL=openai/gpt-5.4-mini
